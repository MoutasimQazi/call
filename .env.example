# Copy to .env on the server and fill in the real values:
#   cp .env.example .env && nano .env
#
# This file is what the LiveKit worker reads. The SetEnv lines in .htaccess
# only reach the LiteSpeed web server process -- a worker started from SSH or
# cron sees none of them, which is why it cannot register with LiveKit.
# .env is git-ignored, so the credentials stay on the server.

LIVEKIT_URL=wss://calling-agent-xxxxxxxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

OPENAI_API_KEY=

# Optional: only needed for the DeepSeek model option.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Speech for the pipeline models, served by LiveKit Inference.
# LIVEKIT_STT_MODEL=deepgram/nova-3
# LIVEKIT_TTS_MODEL=cartesia/sonic-3
# LIVEKIT_TTS_VOICE=

# Logging. Drop to INFO once calls are working.
LOG_LEVEL=DEBUG
# LOG_VIEW_TOKEN=
